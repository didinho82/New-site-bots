<?php
/**
 * Configuração da aplicação.
 * Copie este arquivo para config.php e ajuste os valores.
 */
return [
    // URL pública do site (usada para registrar o webhook do Telegram).
    // Deve ser HTTPS em produção. Ex.: https://meusite.com
    'app_url' => getenv('APP_URL') ?: 'http://localhost:8000',

    // Banco de dados (PDO). Por padrão usa SQLite (zero configuração).
    // Para MySQL: 'mysql:host=localhost;dbname=botbuilder;charset=utf8mb4'
    'db_dsn'  => getenv('DB_DSN') ?: 'sqlite:' . __DIR__ . '/data/app.sqlite',
    'db_user' => getenv('DB_USER') ?: '',
    'db_pass' => getenv('DB_PASS') ?: '',

    // Caminho do interpretador Python usado para rodar os scripts dos comandos.
    'python_bin' => getenv('PYTHON_BIN') ?: 'python3',

    // Tempo máximo (segundos) de execução de um script de comando.
    'script_timeout' => 15,

    // Nome da aplicação exibido na interface.
    'app_name' => 'BotForge',
];
